# Copier ce fichier en `.env` et remplir les valeurs.
# Le .env ne doit JAMAIS etre commite (deja dans .gitignore).

# Connexion PostgreSQL (Sequelize lit DATABASE_URL via config/config.json)
# Local : postgres://user:password@localhost:5432/groupomania
# Render : utiliser l'"Internal Database URL" fournie par Render
DATABASE_URL=postgres://user:password@localhost:5432/groupomania

# Base utilisee pour les tests (optionnel)
DATABASE_TEST_URL=postgres://user:password@localhost:5432/groupomania_test

# Environnement : development | production | test
NODE_ENV=development

# Port d'ecoute du serveur
PORT=3000

# Origine(s) autorisee(s) par CORS (URL du front), separees par des virgules.
# Defaut "*" si non defini. En prod, mettre l'URL exacte du front.
CORS_ORIGIN=http://localhost:3001

# Secret de signature des JWT (chaine aleatoire longue)
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me

# Cle de chiffrement des emails en base (chaine aleatoire longue)
EMAIL_SECRET=change_me

# Compte admin cree par `npm run seed`
ADMIN_EMAIL=admin@groupomania.com
ADMIN_PASSWORD=change_me_strong

# Cloudinary (stockage des images uploadees)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
